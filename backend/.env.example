# ===================================================================
# RENDER BACKEND ENVIRONMENT VARIABLES (Copy & Paste to Render Dashboard)
# ===================================================================

NODE_ENV=production
PORT=10000

# MongoDB Atlas Cloud Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/MDS?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Cloudinary Storage for Member Photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend URL (Vercel)
FRONTEND_URL=https://msd-nine.vercel.app
