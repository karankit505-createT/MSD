# ===================================================================
# DIGITALOCEAN PRODUCTION ENVIRONMENT VARIABLES (Backend App Platform / Droplet)
# ===================================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas Cloud Database (or DigitalOcean Managed MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/MDS?retryWrites=true&w=majority

# Authentication & Security (Never hardcode in code; min 32 chars in production)
JWT_SECRET=your_jwt_secret_min_32_characters_here
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_strong_admin_password_here

# Cloudinary Storage for Member Photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend URL for CORS (e.g. DigitalOcean App Platform / Custom Domain)
FRONTEND_URL=https://<your-frontend-domain>
# Optional: Comma-separated additional allowed CORS origins
# ALLOWED_ORIGINS=https://mahasevadal.org,https://www.mahasevadal.org
